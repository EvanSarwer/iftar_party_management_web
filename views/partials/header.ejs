<!DOCTYPE html>
<html lang="en">
  <head>
    <%
      const site = typeof siteMeta !== 'undefined' && siteMeta ? siteMeta : {
        siteName: 'CBA14 Iftar Gathering 2026',
        baseUrl: '',
        defaultDescription: 'CBA14 Iftar Gathering 2026 event website.',
        defaultImage: '/og-image.svg',
        favicon: '/favicon.svg',
        themeColor: '#020617'
      };
      const pageConfig = typeof pageMeta !== 'undefined' && pageMeta ? pageMeta : {};
      const resolvedTitle = pageConfig.title || (typeof title !== 'undefined' ? title : site.siteName);
      const resolvedDescription = pageConfig.description || site.defaultDescription;
      const safePath = typeof requestPath !== 'undefined' && requestPath ? requestPath : '/';
      const resolvedUrl = pageConfig.url || `${site.baseUrl || ''}${safePath}`;
      const resolvedImage = pageConfig.image || `${site.baseUrl || ''}${site.defaultImage}`;
      const noIndex = Boolean(pageConfig.noIndex);
    %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= resolvedTitle %></title>
    <meta name="description" content="<%= resolvedDescription %>" />
    <meta name="theme-color" content="<%= site.themeColor %>" />
    <meta name="robots" content="<%= noIndex ? 'noindex, nofollow' : 'index, follow' %>" />
    <link rel="canonical" href="<%= resolvedUrl %>" />
    <link rel="icon" type="image/svg+xml" href="<%= site.favicon %>" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="<%= site.siteName %>" />
    <meta property="og:title" content="<%= resolvedTitle %>" />
    <meta property="og:description" content="<%= resolvedDescription %>" />
    <meta property="og:url" content="<%= resolvedUrl %>" />
    <meta property="og:image" content="<%= resolvedImage %>" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= resolvedTitle %>" />
    <meta name="twitter:description" content="<%= resolvedDescription %>" />
    <meta name="twitter:image" content="<%= resolvedImage %>" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#f6f2e8',
                100: '#efe4c7',
                200: '#e3cf97',
                300: '#d5b463',
                400: '#c89d3f',
                500: '#b68024',
                600: '#93661c',
                700: '#724d16',
                800: '#513711',
                900: '#33230a'
              }
            },
            boxShadow: {
              glow: '0 20px 60px rgba(182, 128, 36, 0.24)'
            }
          }
        }
      };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css" />
    <script>
      (function () {
        try {
          var savedTheme = localStorage.getItem('theme');
          if (savedTheme === 'light') {
            document.documentElement.classList.add('light-theme');
          }
        } catch (error) {
          console.warn('Theme preference unavailable.', error);
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <div class="app-background fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(182,128,36,0.24),_transparent_35%),linear-gradient(135deg,#020617_0%,#0f172a_40%,#111827_100%)]"></div>
      <div class="absolute -top-24 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-brand-500/10 blur-3xl"></div>
    </div>

    <header class="site-header sticky top-0 z-40 border-b border-white/10 bg-slate-950/75 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-3 sm:px-6 sm:py-4 lg:flex-row lg:items-center lg:justify-between lg:px-8">
        <div class="flex w-full items-center justify-between gap-3 lg:w-auto lg:flex-1 lg:justify-start">
          <a href="/" class="flex min-w-0 items-center gap-2.5 self-start lg:self-auto">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-500/15 text-lg shadow-glow sm:h-11 sm:w-11 sm:rounded-2xl sm:text-xl">🌙</div>
            <div class="min-w-0">
              <p class="text-[9px] uppercase tracking-[0.24em] text-brand-300 sm:text-xs sm:tracking-[0.35em]">Batch CBA14</p>
              <h1 class="text-sm font-extrabold text-white sm:text-lg">Iftar Gathering 2026</h1>
            </div>
          </a>
          <button type="button" class="theme-toggle inline-flex shrink-0 items-center justify-center gap-2 self-start rounded-full border border-white/10 bg-white/5 px-3 py-2 text-xs font-semibold text-slate-200 transition hover:bg-white/10 sm:px-4 sm:text-sm lg:hidden" data-theme-toggle aria-label="Switch to light mode">
            <span class="theme-toggle-icon" aria-hidden="true">☀️</span>
            <span class="theme-toggle-text">Light</span>
          </button>
        </div>
        <div class="flex w-full flex-col gap-2.5 lg:w-auto lg:flex-row lg:items-center">
          <nav class="site-nav grid w-full grid-cols-2 items-center gap-1.5 rounded-2xl border border-white/10 bg-white/5 p-1 text-center text-xs font-medium sm:grid-cols-4 sm:gap-2 sm:text-sm lg:w-auto lg:rounded-full">
            <a href="/" class="rounded-xl px-3 py-2 transition lg:rounded-full lg:px-4 <%= currentPage === 'home' ? 'bg-brand-500 text-slate-950' : 'text-slate-200 hover:bg-white/10' %>">Home</a>
            <a href="/calculation" class="rounded-xl px-3 py-2 transition lg:rounded-full lg:px-4 <%= currentPage === 'calculation' ? 'bg-brand-500 text-slate-950' : 'text-slate-200 hover:bg-white/10' %>">Calculation</a>
            <a href="/contact" class="rounded-xl px-3 py-2 transition lg:rounded-full lg:px-4 <%= currentPage === 'contact' ? 'bg-brand-500 text-slate-950' : 'text-slate-200 hover:bg-white/10' %>">Contact</a>
            <a href="/admin" class="rounded-xl px-3 py-2 transition lg:rounded-full lg:px-4 <%= currentPage === 'admin' ? 'bg-brand-500 text-slate-950' : 'text-slate-200 hover:bg-white/10' %>">Admin</a>
          </nav>
          <button type="button" class="theme-toggle hidden items-center justify-center gap-2 self-end rounded-full border border-white/10 bg-white/5 px-3 py-2 text-xs font-semibold text-slate-200 transition hover:bg-white/10 sm:px-4 sm:text-sm lg:inline-flex lg:self-auto" data-theme-toggle aria-label="Switch to light mode">
            <span class="theme-toggle-icon" aria-hidden="true">☀️</span>
            <span class="theme-toggle-text">Light</span>
          </button>
        </div>
      </div>
    </header>

    <main>
