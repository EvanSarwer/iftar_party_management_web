<%- include('partials/header', { title, currentPage }) %>

<section class="mx-auto max-w-7xl px-4 pb-10 pt-4 sm:px-6 lg:px-8 lg:pb-16 lg:pt-8">
  <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-stretch">
    <div class="glass-panel ramadan-pattern hero-festive rounded-[2rem] p-5 sm:p-8 lg:p-9">
      <div class="relative z-10">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <span class="glass-multicolor-text text-xl font-extrabold tracking-[0.16em] sm:text-2xl">#CBA14</span>
          <div class="flex items-center gap-2 text-lg sm:text-xl">
            <span class="hero-ornament">🌙</span>
            <span class="hero-ornament">🕌</span>
            <span class="hero-ornament">✨</span>
          </div>
        </div>
        <p class="mb-4 inline-flex rounded-full border border-brand-400/30 bg-brand-400/10 px-3 py-2 text-[10px] font-bold uppercase tracking-[0.25em] text-brand-200 sm:px-4 sm:text-xs sm:tracking-[0.35em]">
          <%= event.tagline %>
        </p>
        <h2 class="max-w-3xl text-2xl font-extrabold tracking-tight text-white sm:text-3xl lg:text-[2.45rem]">
          <span class="block">Reunion through a blessed Ramadan Iftar.</span>
        </h2>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-300 sm:text-base sm:leading-7">
          <%= event.description %>
        </p>

        <div class="mt-6 flex flex-col gap-3">
          <a href="/calculation/invoice" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center self-start rounded-full bg-emerald-300 px-6 py-3 text-sm font-bold text-emerald-950 transition hover:bg-emerald-200">
            Download Simple Invoice
          </a>

          <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="#join" class="rounded-full bg-brand-500 px-6 py-3 text-center text-sm font-bold text-slate-950 transition hover:bg-brand-400">Add Your Name</a>
          <a href="#attendees" class="rounded-full border border-white/15 px-6 py-3 text-center text-sm font-bold text-white transition hover:bg-white/10">See Attendee List</a>
          </div>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          <div class="rounded-3xl border border-emerald-400/20 bg-gradient-to-br from-emerald-500/25 via-emerald-400/10 to-transparent p-5 shadow-lg shadow-emerald-950/20 backdrop-blur-sm">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-200">Contribution</p>
                <p class="mt-2 text-xl font-extrabold text-white"><%= event.contribution %> <%= event.currency %></p>
              </div>
              <span class="flex h-10 w-10 items-center justify-center rounded-2xl border border-emerald-300/20 bg-emerald-500/20 text-xl shadow-lg shadow-emerald-950/20">💸</span>
            </div>
          </div>
          <div class="rounded-3xl border border-amber-400/20 bg-gradient-to-br from-amber-500/25 via-orange-400/10 to-transparent p-5 shadow-lg shadow-amber-950/20 backdrop-blur-sm">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-200">Event Date</p>
                <p class="mt-2 text-base font-bold leading-6 text-white"><%= event.dateLabel %></p>
              </div>
              <span class="flex h-10 w-10 items-center justify-center rounded-2xl border border-amber-300/20 bg-amber-500/20 text-xl shadow-lg shadow-amber-950/20">📅</span>
            </div>
          </div>
          <div class="rounded-3xl border border-sky-400/20 bg-gradient-to-br from-sky-500/25 via-cyan-400/10 to-transparent p-5 shadow-lg shadow-sky-950/20 backdrop-blur-sm">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-200">Venue</p>
                <p class="mt-2 text-base font-bold leading-6 text-white"><%= event.venue %></p>
              </div>
              <span class="flex h-10 w-10 items-center justify-center rounded-2xl border border-sky-300/20 bg-sky-500/20 text-xl shadow-lg shadow-sky-950/20">📍</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="glass-panel rounded-[2rem] p-5 sm:p-8 lg:h-full">
      <div class="rounded-[1.75rem] border border-brand-400/20 bg-gradient-to-br from-brand-500/20 via-white/5 to-transparent p-5 sm:p-6 lg:flex lg:h-full lg:flex-col">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-[10px] uppercase tracking-[0.25em] text-brand-200 sm:text-xs sm:tracking-[0.35em]">Invitation Note</p>
            <h3 class="mt-3 text-xl font-extrabold text-white sm:text-2xl">Let us gather with love and brotherhood</h3>
          </div>
          <span class="text-4xl">✨</span>
        </div>
        <p class="mt-4 text-sm leading-6 text-slate-300 sm:leading-7">
          Your presence will make this event more meaningful and joyful, InshaAllah. We welcome every friend of Batch CBA14 to join, reconnect, and share a memorable evening together.
        </p>
        <div class="mt-6 space-y-4 lg:mt-auto">
          <div class="rounded-2xl border border-red-400/30 bg-gradient-to-br from-red-500/30 via-rose-500/20 to-transparent p-4 shadow-lg shadow-red-950/20">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs uppercase tracking-[0.25em] text-red-200">Collection Deadline</p>
                <p class="mt-2 text-lg font-extrabold text-red-50"><%= event.collectionDeadlineLabel %></p>
              </div>
              <span class="flex h-10 w-10 items-center justify-center rounded-2xl border border-red-300/30 bg-red-500/20 text-xl text-red-100 shadow-lg shadow-red-950/30">⏰</span>
            </div>
          </div>
          <div class="rounded-2xl border border-[#e2136e]/35 bg-gradient-to-br from-[#e2136e]/25 via-fuchsia-500/15 to-transparent p-4 shadow-lg shadow-fuchsia-950/20">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="inline-flex items-center gap-2 rounded-full border border-[#f7a6c7]/30 bg-[#e2136e]/15 px-3 py-1 text-xs font-bold text-pink-50 shadow-sm shadow-fuchsia-950/20">
                  <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#e2136e]/30">
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="h-3.5 w-3.5 fill-current text-white">
                      <path d="M11.97 2.5 8.9 7.52l3.07 1.72 3.1-1.72-3.1-5.02Zm-4.9 6.07L3.5 14.4l5.58-1.25 2.04-3.13-4.05-1.45Zm9.86 0-4.05 1.45 2.04 3.13 5.58 1.25-3.57-5.83Zm-6.58 2.88-1.8 2.8 3.42 7.25 3.42-7.25-1.8-2.8-1.62.9-1.62-.9Z"/>
                    </svg>
                  </span>
                  <span>bKash</span>
                </div>
                <p class="mt-3 text-xs uppercase tracking-[0.25em] text-pink-100">bKash Payment</p>
                <p class="mt-2 text-lg font-bold text-white"><%= event.bkash %></p>
              </div>
              <span class="flex h-10 w-10 items-center justify-center rounded-2xl border border-[#f7a6c7]/30 bg-[#e2136e]/20 text-xl shadow-lg shadow-fuchsia-950/20">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 fill-current text-pink-50">
                  <path d="M11.97 2.5 8.9 7.52l3.07 1.72 3.1-1.72-3.1-5.02Zm-4.9 6.07L3.5 14.4l5.58-1.25 2.04-3.13-4.05-1.45Zm9.86 0-4.05 1.45 2.04 3.13 5.58 1.25-3.57-5.83Zm-6.58 2.88-1.8 2.8 3.42 7.25 3.42-7.25-1.8-2.8-1.62.9-1.62-.9Z"/>
                </svg>
              </span>
            </div>
          </div>
          <div class="rounded-2xl border border-white/10 bg-slate-950/50 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-slate-400">Quick Status</p>
            <div class="mt-3 grid grid-cols-1 gap-3 text-center sm:grid-cols-3">
              <div class="rounded-2xl bg-white/5 p-3">
                <p class="text-2xl font-extrabold text-white"><%= counts.total %></p>
                <p class="text-xs text-slate-400">Total</p>
              </div>
              <div class="rounded-2xl bg-emerald-500/10 p-3">
                <p class="text-2xl font-extrabold text-emerald-300"><%= counts.confirmed %></p>
                <p class="text-xs text-slate-400">Confirmed</p>
              </div>
              <div class="rounded-2xl bg-amber-500/10 p-3">
                <p class="text-2xl font-extrabold text-amber-300"><%= counts.pending %></p>
                <p class="text-xs text-slate-400">Pending</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="join" class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
  <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="glass-panel rounded-[2rem] p-5 sm:p-8">
      <p class="text-[10px] font-bold uppercase tracking-[0.25em] text-brand-200 sm:text-xs sm:tracking-[0.35em]">Join the Gathering</p>
      <h3 class="mt-3 text-2xl font-extrabold text-white sm:text-3xl">Add your name to the attendee list</h3>
      <p class="mt-3 text-sm leading-7 text-slate-300">
        Submit your name to join. Mobile number is optional. Your request will appear as pending until the admin confirms your joining.
      </p>
      <form class="mt-6 space-y-4" data-attendee-form>
        <div>
          <label class="mb-2 block text-sm font-semibold text-slate-200" for="name">Full name <span class="text-rose-400">*</span></label>
          <input id="name" name="name" type="text" placeholder="Enter your name" required class="w-full rounded-2xl border border-white/10 bg-slate-900/80 px-4 py-3 text-white outline-none ring-0 placeholder:text-slate-500 focus:border-brand-400" />
        </div>
        <div>
          <label class="mb-2 block text-sm font-semibold text-slate-200" for="phone">Mobile number <span class="text-xs font-normal text-slate-400">(optional)</span></label>
          <input id="phone" name="phone" type="text" placeholder="01XXXXXXXXX" class="w-full rounded-2xl border border-white/10 bg-slate-900/80 px-4 py-3 text-white outline-none ring-0 placeholder:text-slate-500 focus:border-brand-400" />
        </div>
        <button type="submit" class="w-full rounded-2xl bg-brand-500 px-5 py-3 font-bold text-slate-950 transition hover:bg-brand-400">Submit as Pending</button>
        <p data-attendee-message class="mt-4 text-sm text-slate-400">Your status will be visible in the list below after submission.</p>
      </form>
    </div>

    <div class="glass-panel rounded-[2rem] p-5 sm:p-8">
      <p class="text-[10px] font-bold uppercase tracking-[0.25em] text-brand-200 sm:text-xs sm:tracking-[0.35em]">Collection Details</p>
      <h3 class="mt-3 text-2xl font-extrabold text-white sm:text-3xl">Everything you need to know</h3>
      <div class="mt-6 space-y-4 text-slate-300">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
          <p class="text-sm font-semibold text-white">Contribution</p>
          <p class="mt-2"><%= event.contribution %> <%= event.currency %> for each classmate.</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
          <p class="text-sm font-semibold text-white">Cash Collection Points</p>
          <ul class="mt-3 space-y-2">
            <% event.collectionPoints.forEach((point) => { %>
              <li class="rounded-2xl bg-slate-900/60 px-4 py-3"><%= point %></li>
            <% }) %>
          </ul>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
          <p class="text-sm font-semibold text-white">Important note</p>
          <p class="mt-2"><%= event.note %></p>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="attendees" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
  <div class="glass-panel rounded-[2rem] p-5 sm:p-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.25em] text-brand-200 sm:text-xs sm:tracking-[0.35em]">Attendee Directory</p>
        <h3 class="mt-3 text-2xl font-extrabold text-white sm:text-3xl">Friends who are joining the Iftar</h3>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300">Search by name to quickly see whether a friend is already confirmed or still pending.</p>
      </div>
      <div class="w-full max-w-md">
        <label class="mb-2 block text-sm font-semibold text-slate-200" for="search">Search attendee</label>
        <input id="search" data-attendee-search type="text" placeholder="Search by name" class="w-full rounded-2xl border border-white/10 bg-slate-900/80 px-4 py-3 text-white outline-none placeholder:text-slate-500 focus:border-brand-400" />
      </div>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% attendees.forEach((attendee) => { %>
        <article data-attendee-item data-name="<%= attendee.name.toLowerCase() %>" data-phone="<%= attendee.phone %>" class="attendee-row rounded-3xl border border-white/10 bg-white/[0.03] p-5">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h4 class="text-lg font-bold text-white"><%= attendee.name %></h4>
              <p class="mt-1 text-sm text-slate-400"><%= attendee.phone %></p>
            </div>
            <span class="status-badge <%= attendee.status === 'confirmed' ? 'status-confirmed' : 'status-pending' %>">
              <span><%= attendee.status === 'confirmed' ? '✓' : '⏳' %></span>
              <%= attendee.status %>
            </span>
          </div>
          <div class="mt-4 flex flex-col gap-1 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
            <span>Requested: <%= new Date(attendee.createdAt).toLocaleDateString() %></span>
            <span class="sm:text-right">
              <%= attendee.confirmedAt ? `Confirmed: ${new Date(attendee.confirmedAt).toLocaleDateString()}` : 'Awaiting approval' %>
            </span>
          </div>
        </article>
      <% }) %>
    </div>

    <div data-attendee-empty class="hidden rounded-3xl border border-dashed border-white/10 bg-white/[0.03] p-10 text-center text-slate-400">
      No attendee found with this name.
    </div>
  </div>
</section>

<a class="whatsapp-float flex h-11 w-11 items-center justify-center rounded-full bg-[#25D366] text-white shadow-2xl ring-4 ring-white/10 transition hover:scale-105 sm:h-12 sm:w-12" href="https://wa.me/<%= event.whatsAppNumber %>?text=Assalamu%20Alaikum%2C%20I%20want%20to%20know%20more%20about%20the%20CBA14%20Iftar%20Gathering." target="_blank" rel="noreferrer" aria-label="Message on WhatsApp">
  <svg viewBox="0 0 32 32" aria-hidden="true" class="h-7 w-7 sm:h-8 sm:w-8 fill-current">
    <path d="M19.11 17.18c-.27-.14-1.6-.79-1.85-.88-.25-.09-.43-.14-.62.14-.18.27-.71.88-.87 1.06-.16.18-.32.2-.59.07-.27-.14-1.13-.42-2.15-1.35-.8-.72-1.34-1.61-1.49-1.88-.16-.27-.02-.42.12-.55.12-.12.27-.32.41-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.62-1.5-.85-2.05-.22-.53-.45-.46-.62-.47l-.53-.01c-.18 0-.48.07-.73.34-.25.27-.96.94-.96 2.3s.98 2.67 1.12 2.85c.14.18 1.92 2.93 4.65 4.11.65.28 1.16.45 1.55.57.65.21 1.24.18 1.71.11.52-.08 1.6-.65 1.82-1.28.23-.63.23-1.17.16-1.28-.07-.11-.25-.18-.52-.32Z"/>
    <path d="M16.02 3.2c-7.07 0-12.8 5.71-12.8 12.76 0 2.25.59 4.44 1.71 6.36L3.1 28.8l6.64-1.74a12.84 12.84 0 0 0 6.28 1.63h.01c7.06 0 12.79-5.71 12.79-12.76 0-3.41-1.33-6.62-3.74-9.03a12.74 12.74 0 0 0-9.06-3.7Zm0 23.32h-.01a10.6 10.6 0 0 1-5.39-1.47l-.39-.23-3.94 1.03 1.05-3.84-.25-.4a10.55 10.55 0 0 1-1.62-5.62c0-5.87 4.78-10.65 10.66-10.65 2.84 0 5.5 1.1 7.5 3.11a10.55 10.55 0 0 1 3.11 7.49c0 5.87-4.79 10.65-10.72 10.65Z"/>
  </svg>
</a>

<%- include('partials/footer') %>
